{
  "name": "multi-ai-ball",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MultAIBall: run one prompt, a sweep of variations, or a whole spreadsheet across many language models from your browser, with a Python bundle that reproduces the run.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e/app.spec.ts tests/e2e/providers.spec.ts",
    "test:e2e:live": "playwright test tests/e2e/live.spec.ts",
    "test:e2e:all": "playwright test",
    "stub": "node dev/stub-server.mjs",
    "sync:models-dev": "node scripts/sync-models-dev.mjs",
    "check": "tsc --noEmit && vitest run && playwright test tests/e2e/app.spec.ts tests/e2e/providers.spec.ts",
    "probe": "MULTIAIBALL_LIVE_PROBE=1 vitest run --config scripts/probe/vitest.config.ts"
  },
  "dependencies": {
    "gpt-tokenizer": "^3.4.0",
    "jsonrepair": "^3.12.0",
    "jszip": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "^5.6.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
