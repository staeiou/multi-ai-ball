{
  "id": "nebius",
  "name": "Nebius AI",
  "type": "api",
  "baseUrl": "https://api.studio.nebius.ai",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "envVar": "NEBIUS_API_KEY"
  },
  "execution": {
    "defaultConcurrency": 8,
    "maxConcurrency": 32,
    "timeout": 180000,
    "description": "Nebius AI Studio - OpenAI-compatible API"
  },
  "headers": {
    "Content-Type": "application/json"
  }
}
