{
  "id": "anthropic",
  "name": "Anthropic Messages",
  "endpoint": "/v1/messages",
  "bodyTransforms": [
    {
      "type": "validation_rule",
      "config": {
        "condition": "messages_present",
        "requiredFields": ["max_tokens"],
        "errorMessage": "max_tokens is required for Anthropic API",
        "description": "Enforce that max_tokens parameter is provided"
      }
    },
    {
      "type": "validation_rule",
      "config": {
        "condition": "field_comparison",
        "field": "thinking.budget_tokens",
        "compareWith": "max_tokens",
        "operator": "less_than",
        "errorMessage": "thinking.budget_tokens must be less than max_tokens",
        "description": "Ensure thinking budget is smaller than total token limit"
      }
    }
  ],
  "usageExtraction": {
    "promptTokensPath": "usage.input_tokens",
    "completionTokensPath": "usage.output_tokens",
    "totalTokensPath": "usage.total_tokens"
  },
  "modelRules": [
    {
      "pattern": "^claude",
      "name": "Claude Models",
      "params": {
        "max_tokens": {
          "type": "integer",
          "description": "Maximum response length (1 token ≈ 3-4 characters)",
          "min": 1,
          "max": 16384,
          "default": 2048,
          "basic": true,
          "required": true,
          "is_output_length": true
        },
        "temperature": {
          "type": "number",
          "description": "Predictability (0 = more stable & deterministic, 1 = more stochastic & \"creative\"), must be 1 if thinking is enabled",
          "min": 0,
          "max": 1,
          "default": 0,
          "basic": true,
          "forced_value_when": {
            "parameter": "thinking.type",
            "equals": "enabled",
            "value": 1
          }
        },
        "thinking": {
          "type": "object",
          "description": "Extended thinking configuration",
          "basic": true,
          "properties": {
            "type": {
              "type": "string",
              "description": "Enable extended thinking",
              "enum": ["enabled"],
              "basic": true
            },
            "budget_tokens": {
              "type": "integer",
              "description": "Maximum tokens for thinking process (must be less than max_tokens)",
              "min": 1,
              "max": 10000,
              "basic": true,
              "auto_set_when": {
                "parameter": "thinking.type",
                "equals": "enabled",
                "value": 1024
              }
            }
          }
        }
      }
    }
  ],
  "responseModes": {
    "text": {
      "id": "text",
      "label": "Text",
      "description": "Standard text response",
      "parameters": {},
      "responseTransform": {
        "contentPath": "content[?(@.type=='text')].text",
        "fallbackPaths": ["content[0].text", "content[0]", "content"],
        "errorPath": "error.message",
        "reasoningPath": "content[?(@.type=='thinking')].thinking"
      }
    }
  },
  "bodyConstruction": {
    "promptField": "messages",
    "wrapAsArray": true,
    "messageRole": "user"
  },
  "systemPromptConfig": {
    "mode": "field",
    "fieldName": "system"
  }
}