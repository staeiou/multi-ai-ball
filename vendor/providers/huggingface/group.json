{
  "id": "huggingface",
  "name": "Hugging Face Inference Providers",
  "type": "api",
  "baseUrl": "https://router.huggingface.co",
  "auth": {
    "type": "bearer",
    "header": "Authorization",
    "envVar": "HUGGINGFACE_API_KEY"
  },
  "execution": {
    "defaultConcurrency": 4,
    "maxConcurrency": 16,
    "timeout": 180000,
    "description": "Hugging Face Inference Providers - unified router across Together, Groq, Fireworks, Cerebras, and other backend providers"
  },
  "headers": {
    "Content-Type": "application/json"
  }
}
