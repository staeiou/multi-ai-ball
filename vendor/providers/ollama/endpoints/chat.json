{
  "id": "ollama-chat",
  "name": "Ollama Chat",
  "endpoint": "/api/chat",
  "method": "POST",
  "bodyConstruction": {
    "promptField": "messages",
    "wrapAsArray": true,
    "messageRole": "user",
    "paramNesting": {
      "container": "options",
      "excludeFromNesting": ["stream", "tools", "think", "format", "keep_alive"]
    }
  },
  "streamingTransform": {
    "format": "ndjson",
    "contentPaths": ["message.content"],
    "doneDetection": {
      "field": "done",
      "value": true
    },
    "finalResponseConstruction": {
      "contentField": "message.content"
    }
  },
  "usageExtraction": {
    "promptTokensPath": "prompt_eval_count",
    "completionTokensPath": "eval_count",
    "totalTokensPath": "prompt_eval_count,eval_count"
  },
  "responseModes": {
    "text": {
      "id": "text",
      "label": "Text",
      "description": "Standard text response",
      "parameters": {},
      "responseTransform": {
        "contentPath": "message.content",
        "fallbackPaths": ["response", "content"],
        "errorPath": "error",
        "reasoningPath": "message.thinking"
      }
    },
    "json": {
      "id": "json",
      "label": "JSON",
      "description": "Structured JSON response",
      "parameters": {
        "format": "json"
      },
      "promptTransform": {
        "append": "\nPlease respond with a JSON object in the form {'answer': answer}"
      },
      "responseTransform": {
        "contentPath": "message.content",
        "fallbackPaths": ["response", "content"],
        "errorPath": "error",
        "isJSON": true,
        "reasoningPath": "message.thinking"
      }
    }
  },
  "structuredOutput": {
    "modeParameter": "format",
    "requiresParameter": "format",
    "ownedParameters": ["format"],
    "modes": {
      "json_object": {
        "label": "JSON object",
        "description": "Guarantees valid JSON, but does not enforce the prompt's response fields or their types.",
        "parameters": {
          "format": "json"
        }
      },
      "json_schema": {
        "label": "Structured output (JSON Schema)",
        "description": "Enforces the response fields defined by this prompt. Ollama takes the generated schema directly as its response format.",
        "requiresSchema": true,
        "parameters": {
          "format": "{{SCHEMA}}"
        }
      }
    }
  },
  "modelRules": [
    {
      "pattern": "gpt-oss",
      "name": "GPT-OSS Models",
      "params": {
        "frequency_penalty": {
          "type": "number",
          "description": "Frequency penalty (-2 = encourage repetition, 0 = off, 2 = max)",
          "basic": false
        },
        "presence_penalty": {
          "type": "number",
          "description": "Presence penalty (-2 = encourage repetition, 0 = off, 2 = max)",
          "basic": false
        },
        "repeat_penalty": {
          "type": "number",
          "description": "Repetition penalty (0.9 = lenient, 1.1 = model default, 1.5 = strong)",
          "basic": false
        },
        "top_k": {
          "type": "integer",
          "description": "Top-k sampling (1 = top token only, 40 = model default, 100 = broad)",
          "basic": false
        },
        "top_p": {
          "type": "number",
          "description": "Nucleus sampling (0.5 = focused, 0.9 = model default, 1 = all tokens)",
          "min": 0,
          "max": 1,
          "basic": false
        },
        "min_p": {
          "type": "number",
          "description": "Minimum probability (0 = model default, 0.05 = typical, 1 = top token only)",
          "min": 0,
          "max": 1,
          "basic": false
        },
        "tools": {
          "type": "array",
          "description": "List of tools in JSON for the model to use",
          "basic": false
        },
        "think": {
          "type": "boolean",
          "description": "Should thinking models think before responding",
          "basic": false
        },
        "temperature": {
          "type": "number",
          "description": "Predictability (0 = minimum variation, 1 = model default, 2 = max variation)",
          "min": 0,
          "max": 2,
          "basic": true
        },
        "num_predict": {
          "type": "integer",
          "description": "Maximum response length (1 token ≈ 3-4 characters)",
          "default": 2048,
          "basic": true,
          "is_output_length": true
        },
        "num_keep": {
          "type": "integer",
          "description": "Number of tokens to keep from prompt",
          "basic": false
        },
        "seed": {
          "type": "integer",
          "description": "Random seed for reproducible outputs",
          "basic": false
        },
        "typical_p": {
          "type": "number",
          "description": "Typical probability threshold",
          "min": 0,
          "max": 1,
          "basic": false
        },
        "repeat_last_n": {
          "type": "integer",
          "description": "Repetition lookback (0 = off, 64 = model default, -1 = whole context)",
          "basic": false
        },
        "penalize_newline": {
          "type": "boolean",
          "description": "Penalize newline tokens",
          "basic": false
        },
        "stop": {
          "type": "array",
          "description": "Stop sequences",
          "basic": false
        },
        "numa": {
          "type": "boolean",
          "description": "Enable NUMA optimization",
          "basic": false
        },
        "num_ctx": {
          "type": "integer",
          "description": "Context window size",
          "basic": false
        },
        "num_batch": {
          "type": "integer",
          "description": "Batch size for token processing",
          "basic": false
        },
        "num_gpu": {
          "type": "integer",
          "description": "Number of GPUs to use",
          "basic": false
        },
        "main_gpu": {
          "type": "integer",
          "description": "Main GPU index",
          "basic": false
        },
        "use_mmap": {
          "type": "boolean",
          "description": "Use memory mapping",
          "basic": false
        },
        "num_thread": {
          "type": "integer",
          "description": "Number of threads to use",
          "basic": false
        },
        "format": {
          "type": "string",
          "description": "Response format",
          "enum": ["", "json"],
          "basic": false
        },
        "keep_alive": {
          "type": "string",
          "description": "How long to keep model in memory",
          "basic": false
        },
        "stream": {
          "type": "boolean",
          "description": "Streaming disabled (application cannot process NDJSON)",
          "default": false,
          "required": true,
          "fixed": false,
          "basic": false,
          "hidden": true
        }
      }
    },
    {
      "pattern": ".*",
      "name": "All Ollama Models",
      "params": {
        "frequency_penalty": {
          "type": "number",
          "description": "Frequency penalty (-2 = encourage repetition, 0 = off, 2 = max)",
          "basic": false
