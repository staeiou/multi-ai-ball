        "system": {
          "type": "string",
          "description": "System message",
          "basic": false
        },
        "template": {
          "type": "string",
          "description": "Prompt template",
          "basic": false
        },
        "raw": {
          "type": "boolean",
          "description": "No formatting applied to prompt",
          "default": false,
          "basic": false
        },
        "images": {
