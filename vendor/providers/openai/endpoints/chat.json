{
  "id": "openai-chat",
  "name": "OpenAI Chat Completions",
  "endpoint": "/v1/chat/completions",
  "bodyTransforms": [
    {
      "type": "field_transform",
      "config": {
        "field": "response_format",
        "transform": "string_to_object",
        "transformConfig": {
          "objectWrapper": "type"
        },
        "description": "Wrap response_format string values in {type: value} object"
      }
    }
  ],
  "usageExtraction": {
    "promptTokensPath": "usage.prompt_tokens",
    "completionTokensPath": "usage.completion_tokens",
    "totalTokensPath": "usage.total_tokens"
  },
  "structuredOutput": {
    "modeParameter": "response_format.type",
    "requiresParameter": "response_format",
    "ownedParameters": ["response_format.type", "response_format.json_schema"],
    "modes": {
      "json_object": {
        "label": "JSON object",
        "description": "Guarantees valid JSON, but does not enforce the prompt's response fields or their types.",
        "parameters": {
          "response_format.type": "json_object"
        }
      },
      "json_schema": {
        "label": "Structured output (JSON Schema)",
        "description": "Enforces the response fields defined by this prompt. Auditomatic adds the generated schema to the request.",
        "requiresSchema": true,
        "parameters": {
          "response_format.type": "json_schema",
          "response_format.json_schema": {
            "name": "{{SCHEMA_NAME}}",
            "strict": true,
            "schema": "{{SCHEMA}}"
          }
        }
      }
    }
  },
  "modelRules": [
    {
      "pattern": "^gpt-5\\.[124](?!.*chat-latest)",
      "name": "GPT-5 Series with Logprobs",
      "params": {
        "max_completion_tokens": {
          "type": "integer",
          "description": "Maximum response length including reasoning (1 token ≈ 3-4 characters)",
          "min": 1,
          "default": 2048,
          "is_output_length": true,
          "basic": true
        },
        "reasoning_effort": {
          "type": "string",
          "description": "Reasoning effort level",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "basic": true
        },
        "logprobs": {
          "type": "boolean",
          "description": "Include log probabilities",
          "basic": false,
          "enables_features": {
            "logprobs": {
              "boolean_value": true
            }
          }
        },
        "top_logprobs": {
          "type": "integer",
          "description": "Number of top log probabilities to return for each token",
          "min": 0,
          "max": 20,
          "basic": false
        },
        "response_format": {
          "type": "object",
          "description": "Return a valid JSON object. This does not enforce specific fields or types; instruct the model to return JSON in the prompt.",
          "basic": true,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "json_object",
                "json_schema"
              ],
              "basic": true
            }
          }
        }
      },
      "forbidden": [
        "temperature",
        "top_p",
        "frequency_penalty",
        "presence_penalty",
        "stop"
      ],
      "systemPromptConfig": {
        "mode": "message",
        "role": "developer",
        "contentWrapper": {
          "type": "text",
          "textField": "text"
        }
      }
    },
    {
      "pattern": "^gpt-5",
      "name": "GPT-5 Series (Reasoning Models)",
      "params": {
        "max_completion_tokens": {
          "type": "integer",
          "description": "Maximum response length including reasoning (1 token ≈ 3-4 characters)",
          "min": 1,
          "default": 2048,
          "is_output_length": true,
          "basic": true
        },
        "reasoning_effort": {
          "type": "string",
          "description": "Reasoning effort level",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "basic": true
        },
        "response_format": {
          "type": "object",
          "description": "Return a valid JSON object. This does not enforce specific fields or types; instruct the model to return JSON in the prompt.",
          "basic": true,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "json_object",
                "json_schema"
              ],
              "basic": true
            }
          }
        }
      },
      "forbidden": [
        "temperature",
        "top_p",
        "frequency_penalty",
        "presence_penalty",
        "stop",
        "logprobs",
        "top_logprobs"
      ],
      "systemPromptConfig": {
        "mode": "message",
        "role": "developer",
        "contentWrapper": {
          "type": "text",
          "textField": "text"
        }
      }
    },
    {
      "pattern": "^o[0-9]",
      "name": "O-Series (Reasoning Models)",
      "params": {
        "max_completion_tokens": {
          "type": "integer",
          "description": "Maximum response length including reasoning (1 token ≈ 3-4 characters)",
          "min": 1,
          "default": 2048,
          "is_output_length": true,
          "basic": true
        },
        "reasoning_effort": {
          "type": "string",
          "description": "Reasoning effort level",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "basic": true
        },
        "response_format": {
          "type": "object",
          "description": "Return a valid JSON object. This does not enforce specific fields or types; instruct the model to return JSON in the prompt.",
          "basic": true,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "json_object",
                "json_schema"
              ],
              "basic": true
            }
          }
        }
      },
      "forbidden": [
        "temperature",
        "top_p",
        "frequency_penalty",
        "presence_penalty",
        "stop",
        "logprobs",
        "top_logprobs"
      ],
      "systemPromptConfig": {
        "mode": "message",
        "role": "developer",
        "contentWrapper": {
          "type": "text",
          "textField": "text"
        }
      }
    },
    {
      "pattern": "^gpt-(?:[23](?!\\.5)|4(?:$|-0613$))",
      "name": "Legacy GPT Models without JSON Mode",
      "params": {
        "temperature": {
          "type": "number",
          "description": "Predictability (0 = minimum variation, 1 = model default, 2 = max variation)",
          "min": 0,
          "max": 2,
          "default": 0,
          "basic": true
        },
        "max_completion_tokens": {
          "type": "integer",
          "description": "Maximum response length (1 token ≈ 3-4 characters)",
          "min": 1,
          "default": 2048,
          "is_output_length": true,
          "basic": true
        },
        "logprobs": {
          "type": "boolean",
          "description": "Include log probabilities",
          "basic": false,
          "enables_features": {
            "logprobs": {
              "boolean_value": true
            }
          }
        },
        "top_logprobs": {
          "type": "integer",
          "description": "Number of top log probabilities to return for each token",
          "min": 0,
          "max": 20,
          "basic": false
        }
      },
      "systemPromptConfig": {
        "mode": "message",
        "role": "system",
        "contentWrapper": {
          "type": "text",
          "textField": "text"
        }
      }
    },
    {
      "pattern": "^gpt-[234]",
      "name": "GPT 2/3/4 Models",
      "systemPromptConfig": {
        "mode": "message",
        "role": "system",
        "contentWrapper": {
          "type": "text",
          "textField": "text"
        }
      },
      "params": {
        "temperature": {
          "type": "number",
          "description": "Predictability (0 = minimum variation, 1 = model default, 2 = max variation)",
          "min": 0,
          "max": 2,
          "default": 0,
          "basic": true
        },
        "max_completion_tokens": {
          "type": "integer",
          "description": "Maximum response length (1 token ≈ 3-4 characters)",
          "min": 1,
          "default": 2048,
          "is_output_length": true,
          "basic": true
        },
        "logprobs": {
          "type": "boolean",
          "description": "Include log probabilities",
          "basic": false,
          "enables_features": {
            "logprobs": {
              "boolean_value": true
            }
