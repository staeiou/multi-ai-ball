              ],
              "basic": true
            }
          }
        }
      }
    },
    {
      "pattern": "^gpt-oss",
      "name": "GPT-OSS Models",
      "params": {
        "temperature": {
          "type": "number",
          "description": "Predictability (0 = minimum variation, 1 = model default, 2 = max variation)",
          "min": 0,
          "max": 2,
          "basic": true
        },
        "max_completion_tokens": {
          "type": "integer",
          "description": "Maximum response length (1 token ≈ 3-4 characters)",
          "min": 1,
          "default": 2048,
          "is_output_length": true,
          "basic": true
        },
        "frequency_penalty": {
          "type": "number",
          "description": "Frequency penalty (-2 = encourage repetition, 0 = off, 2 = max)",
          "min": -2,
          "max": 2,
          "basic": false
        },
        "presence_penalty": {
          "type": "number",
          "description": "Presence penalty (-2 = encourage repetition, 0 = off, 2 = max)",
          "min": -2,
          "max": 2,
          "basic": false
        },
        "top_p": {
          "type": "number",
          "description": "Nucleus sampling (0.1 = top 10%, 0.9 = focused, 1 = model default)",
          "min": 0,
          "max": 1,
          "basic": false
        },
        "response_format": {
          "type": "object",
          "description": "Return a valid JSON object. This does not enforce specific fields or types; instruct the model to return JSON in the prompt.",
          "basic": true,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "json_object",
                "json_schema"
              ],
              "basic": true
            }
          }
        }
      },
      "systemPromptConfig": {
        "mode": "message",
        "role": "system"
      }
    },
    {
      "pattern": ".*",
      "name": "Other Models",
      "params": {
        "temperature": {
          "type": "number",
          "description": "Predictability (0 = minimum variation, 1 = model default, 2 = max variation)",
          "min": 0,
          "max": 2,
          "default": 0,
          "basic": true
        },
        "max_completion_tokens": {
          "type": "integer",
          "description": "Maximum response length (1 token ≈ 3-4 characters)",
          "min": 1,
          "default": 2048,
          "is_output_length": true,
          "basic": true
        },
        "frequency_penalty": {
          "type": "number",
          "description": "Frequency penalty (-2 = encourage repetition, 0 = off, 2 = max)",
          "min": -2,
          "max": 2,
          "basic": false
        },
        "presence_penalty": {
          "type": "number",
          "description": "Presence penalty (-2 = encourage repetition, 0 = off, 2 = max)",
          "min": -2,
          "max": 2,
          "basic": false
        },
        "top_p": {
          "type": "number",
